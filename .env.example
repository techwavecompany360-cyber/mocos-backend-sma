# Backend Server Port
PORT=3000

# Node Environment (production / development)
NODE_ENV=production

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net

# MongoDB Database Name
DB_NAME=mocos_database

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed CORS Origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=https://dashboard.mocos.co.tz,https://mocos.co.tz,https://www.mocos.co.tz

# Google Cloud Storage
GCS_BUCKET_NAME=mocos-uploads
GCS_KEY_FILE=./gcs-service-account.json
